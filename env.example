# Copy this to .env  ->  cp env.example .env
# Never commit .env or paste it into a chat.

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=123456:ABC-your-token-from-BotFather
MAIN_CHAT_ID=-1001234567890          # run /id in your group to get this

# ADMIN_IDS is the real one. A Telegram username is rented, not owned: change
# yours and the old handle goes back in the pool for anyone to claim. So a
# handle in ADMIN_USERNAMES is only ever treated as a CLAIM — it is honoured
# once, and only when Telegram agrees that person administrates the group,
# and then their numeric id is pinned to the database and the handle stops
# mattering. Put your own id here anyway (run /id) and nothing depends on a
# name at all.
ADMIN_IDS=                           # numeric ids, comma separated
ADMIN_USERNAMES=KaizenFresh          # @handles, comma separated, no @
# Names Homie answers to, besides his @handle. Members type "homie", not
# "@SpreadLightBot" — without this he never notices he's being spoken to.
BOT_NICKNAMES=homie
# Display name shown in Telegram (applied at startup, no BotFather needed).
BOT_NAME=LIGHT

# --- Personality ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
VOICE_FILE=voice.md
# How he talks vs what he knows. Both are re-read on every reply, so editing
# either one goes live without restarting the bot.
KNOWLEDGE_FILE=knowledge.md
AMBIENT_REPLY_CHANCE=0.12            # how often Homie jumps into chat uninvited
AMBIENT_COOLDOWN_SEC=300
CONTEXT_WINDOW=24
ICEBREAKER_HOUR_UTC=15               # daily check-in post, -1 to disable

# --- Presale watcher --------------------------------------------------------
# PRESALE_ADDRESS is the POOL — the contract that holds contributed BNB.
# /presale reads this address's live balance, so if the two below are swapped
# the total sits at 0.00 forever and nothing ever gets announced.
# Both values are copied from the "Pool Info" and "Token" panels on the
# PinkSale page itself, which is the only source worth trusting for them.
PRESALE_ADDRESS=0x975FfA9d75d4FdfC34B14e6bF5C67eF85fDE3aD9
TOKEN_ADDRESS=0x9cC488396E4973Bf341191Eb6196a1220CdB2E3A
PRESALE_URL=https://www.pinksale.finance/launchpad/bsc/0x975FfA9d75d4FdfC34B14e6bF5C67eF85fDE3aD9
WEBSITE_URL=https://spreadlight.io

CHAIN_BACKEND=etherscan              # or: rpc  (keyless fallback)
ETHERSCAN_API_KEY=
BSC_RPC_URL=https://bsc-dataseed.binance.org
PRESALE_POLL_SEC=45
MIN_ANNOUNCE_BNB=0.01
BIG_GIVER_BNB=0.5                    # at or above this, it's a Big Giver
SOFT_CAP_BNB=5
HARD_CAP_BNB=15
# Taken from the End Time on the PinkSale page: 2026.11.04 13:40 UTC.
# That is 08:40 EST, NOT the 3:00pm EST figure this was originally set to —
# the countdown posts (7d/3d/24h/6h/1h) key off this exact value, so being
# wrong here means Homie announces "6h left" after the sale has already shut.
# If PinkSale's end time is ever edited, change this to match it.
PRESALE_END=2026-11-04T13:40:00+00:00

# --- Scam shield ------------------------------------------------------------
SHIELD_ENABLED=true
ALLOWED_DOMAINS=spreadlight.io,pinksale.finance,bscscan.com,pancakeswap.finance
ALLOWED_TG=SpreadLightToken        # your group — see config.py, empty here is a trap
EXTRA_ALLOWED_ADDRESSES=             # e.g. the charity Gnosis Safe
PROTECTED_NAMES=kaizenfred           # handles to guard, admins auto-added

# --- Games & Lumens ---------------------------------------------------------
POINTS_ENABLED=true
GAMES_ENABLED=true

# Arcade needs a public HTTPS address (see README). Leave blank and everything
# else still works — /scramble, /riddle and /charades need no hosting.
ARCADE_URL=
ARCADE_BIND=127.0.0.1
ARCADE_PORT=8080
ARCADE_DAILY_LUMENS=25

# --- Join captcha -----------------------------------------------------------
CAPTCHA_ENABLED=true
CAPTCHA_TIMEOUT_SEC=180

# --- Content filters --------------------------------------------------------
PROFANITY_FILTER=true
PROFANITY_STRIKES=3
MUTE_MINUTES=60
# A strike this many hours old is forgiven. Without it strikes are permanent,
# so a member who slipped once in March sits one word from a mute in
# September. 0 to keep them forever.
STRIKE_DECAY_HOURS=168
MARKETER_REROUTE=true

# --- AI cost control --------------------------------------------------------
# Every reply Homie writes costs money. Floor between one person's AI replies.
AI_USER_COOLDOWN_SEC=20
# Backstop ceiling on AI replies per chat per hour. 0 disables it.
AI_CHAT_HOURLY_CAP=120

# --- Storage ----------------------------------------------------------------
DB_PATH=spreadlight.db

# --- Only for tools/sweep_deleted.py ----------------------------------------
TG_API_ID=
TG_API_HASH=
TG_GROUP=@yourgroup
